{
  "name": "schooldata/lara-quiz",
  "description": "Laravel package to create forms: surveys, exams, etc.",
  "keywords": [
    "poll",
    "quiz",
    "exam",
    "test",
    "survey",
    "form",
    "Laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sergey Rud",
      "email": "sergey.rud@itrexgroup.com"
    }
  ],
  "require": {
    "php": "^7.2.5",
    "itrex-group/quiz-runner": "dev-master",
    "illuminate/support": "^6.0|^7.0",
    "illuminate/routing": "^6.0|^7.0",
    "illuminate/validation": "^6.0|^7.0",
    "illuminate/database": "^6.0|^7.0",
    "illuminate/view": "^6.0|^7.0",
    "illuminate/config": "^6.0|^7.0",
    "illuminate/auth": "^6.0|^7.0"
  },
  "require-dev": {
    "phpmd/phpmd": "^2.6",
    "sebastian/phpcpd": "^6.0",
    "slevomat/coding-standard": "^8.0",
    "squizlabs/php_codesniffer": "^3.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/itrex-group/quiz-runner"
    }
  ],
  "autoload": {
    "psr-4": {
      "SchoolData\\LaraQuiz\\": "src/LaraQuiz/"
    },
    "classmap": [
      "database/migrations"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "SchoolData\\LaraQuiz\\LaraQuizServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}

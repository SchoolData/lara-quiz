{
  "name": "schooldata/lara-quiz",
  "description": "Laravel package to create forms: surveys, exams, etc.",
  "keywords": [
    "poll",
    "quiz",
    "exam",
    "test",
    "survey",
    "form",
    "Laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "itrex-group/quiz-runner": "dev-master",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/routing": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/validation": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/database": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/view": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/config": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/auth": "^8.0|^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "phpmd/phpmd": "^2.6",
    "sebastian/phpcpd": "^6.0",
    "slevomat/coding-standard": "^8.0",
    "squizlabs/php_codesniffer": "^3.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/itrex-group/quiz-runner"
    }
  ],
  "autoload": {
    "psr-4": {
      "LaraQuiz\\": "src/LaraQuiz/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaraQuiz\\Providers\\LaraQuizServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
